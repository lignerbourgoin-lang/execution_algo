{
  "task_name": "Multi-IP Lottery Queue Orchestrator (20 IPs)",
  "queue_settings": {
    "target_queue_url": "https://queue.example.com/api/queue/status",
    "golden_threshold": 500,
    "min_keep": 2,
    "max_keep": 5,
    "timeout_sec": 5.0,
    "concurrency_limit": 20
  },
  "endpoints": {
    "join_queue": "/api/queue/join",
    "poll_status": "/api/queue/poll",
    "admit_checkout": "/api/checkout/cart"
  },
